# Production Cloud Environment Configuration for akremjobhunter
# Used when deploying to Render, Railway, Fly.io, or Oracle Cloud Always Free VM

# Cloud PostgreSQL Database Connection String
# Example: postgresql://username:password@hostname:5432/akremjobhunter_db
DATABASE_URL=postgresql://akrem_admin:SecureCloudPostgresPass2026@cloud-db-host:5432/akremjobhunter

# Secret encryption key for at-rest stored API secrets (Argon2 / Fernet)
SECRET_KEY=akremjobhunter_super_secret_cloud_encryption_key_32bytes_min

# Legacy access key (for initial mobile pairing before account login)
ACCESS_KEY=akrem2026

# Directory for CV vault PDFs and generated interview packs
DATA_DIR=/data

# Platform Timezone
TIMEZONE=Africa/Tunis

# Maximum daily applications safety ceiling
MAX_DAILY_APPLICATIONS=20

# Environment Mode
ENVIRONMENT=production
